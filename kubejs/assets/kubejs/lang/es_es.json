  "tooltip.kubejs.year_2_cake_1": "¿2 años? ¡El tiempo vuela cuando te diviertes!",
  "tooltip.kubejs.year_2_cake_2": "T¡El pastel es de mentira!",
  "tooltip.kubejs.year_2_cake_3": "05/16/2027",

  "tooltip.kubejs.year_3_cake_1": "¿Ya hay 3 pasteles?",
  "tooltip.kubejs.year_3_cake_2": "¿Cuántos ha preparado con antelación?",
  "tooltip.kubejs.year_3_cake_3": "05/16/2028",

  "tooltip.kubejs.year_4_cake_1": "No, no puede ser, ¿es un cuarto pastel?",
  "tooltip.kubejs.year_4_cake_2": "Respuesta a la pregunta anterior:",
  "tooltip.kubejs.year_4_cake_3": "Probablemente puedas adivinarlo con solo mirar los pasteles.",
  "tooltip.kubejs.year_4_cake_4": "05/16/2029",

  "tooltip.kubejs.year_5_cake_1": "Dato curioso:",
  "tooltip.kubejs.year_5_cake_2": "Estoy escribiendo todas esas descripciones emergentes el 7 de julio de 2026.",
  "tooltip.kubejs.year_5_cake_3": "05/16/2030",

  "tooltip.kubejs.year_6_cake_1": "¡Aquí está el sexto pastel, me pregunto cómo será el séptimo!",
  "tooltip.kubejs.year_6_cake_2": "Si nos habéis estado siguiendo, ¡ya estamos a mitad de camino!",
  "tooltip.kubejs.year_6_cake_3": "05/16/2031",

  "tooltip.kubejs.year_7_cake_1": "Un pequeño consejo: si te preguntas dónde conseguí los huevos y la leche,",
  "tooltip.kubejs.year_7_cake_2": "Son de la granja de pollos y vacas Emerald Grove Gateway.",
  "tooltip.kubejs.year_7_cake_3": "05/16/2032",

  "tooltip.kubejs.year_8_cake_1": "Dato curioso: (Habla Minimaxi)",
  "tooltip.kubejs.year_8_cake_2": "Me llevó 3 días entender cómo hacer pasteles en KubeJS,",
  "tooltip.kubejs.year_8_cake_3": "otros 2 para entender cómo hacer texturas para ellos,",
  "tooltip.kubejs.year_8_cake_4": "Y otro 1 para hacer realmente las texturas para ellos.",
  "tooltip.kubejs.year_8_cake_5": "05/16/2033",

  "tooltip.kubejs.year_9_cake_1": "¡Aquí está el noveno pastel!",
  "tooltip.kubejs.year_9_cake_2": "Trabajaste duro para éste, ¿eh?",
  "tooltip.kubejs.year_9_cake_3": "05/16/2034",

  "tooltip.kubejs.year_10_cake_1": "¡Ya estamos en la década de los dos dígitos, nos estamos haciendo viejos!",
  "tooltip.kubejs.year_10_cake_2": "¡Dos pasteles para llevar!",
  "tooltip.kubejs.year_10_cake_3": "05/16/2035",

  "tooltip.kubejs.year_11_cake_1": "Datos curiosos: (Habla Minimaxi)",
  "tooltip.kubejs.year_11_cake_2": "Esta es la primera vez que trabajo en un paquete de mods y debo decir que ha sido una experiencia muy divertida.",
  "tooltip.kubejs.year_11_cake_3": "Lo curioso es que estos pasteles son mi segundo proyecto secreto; todavía no he terminado el primero.",
  "tooltip.kubejs.year_11_cake_4": "05/16/2036",

  "tooltip.kubejs.year_12_cake_1": "¡Felicidades!",
  "tooltip.kubejs.year_12_cake_2": "¡Gracias por hacer este pastel y por ver este mensaje!",
  "tooltip.kubejs.year_12_cake_3": "Si ves esto, o te diste este objeto a ti mismo o realmente estás jugando.",
  "tooltip.kubejs.year_12_cake_4": "¡12 años después del lanzamiento del paquete de mods, lo cual es impresionante!",
  "tooltip.kubejs.year_12_cake_5": "Espero que te hayas divertido jugando con este paquete de mods, ¡nos vemos algún día!",
  "tooltip.kubejs.year_12_cake_6": "05/16/2037",

